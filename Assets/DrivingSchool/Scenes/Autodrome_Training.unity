    \u0440\u0435\u043C\u0435\u043D\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\n3.
    \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0443 \u0437\u043D\u0430\u043A\u0430
    \u0421\u0422\u041E\u041F \u0438 \u0441\u0442\u043E\u043F-\u043B\u0438\u043D\u0438\u0438\n4.
    \u0423\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u0434\u043E\u0440\u043E\u0433\u0443
    \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u0430\u043C \u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435\n5.
    \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430"
