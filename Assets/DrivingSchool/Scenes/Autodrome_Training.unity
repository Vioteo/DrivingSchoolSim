  m_Name: "Label / 1. \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u0435
    \u0431\u043E\u043B\u0435\u0435 30 \u043A\u043C/\u0447\n2. \u041F\u0440\u0438\u0441\u0442\u0435\u0433\u043D\u0438\u0442\u0435
    \u0440\u0435\u043C\u0435\u043D\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\n3.
